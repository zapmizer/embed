{
  "name": "@zapmizer/embed",
  "version": "0.1.0",
  "description": "Conversa e caixa de entrada da Parli/Zapmizer num iframe, seguindo o protocolo do embed.",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./conversation": {
      "types": "./dist/conversation.d.ts",
      "import": "./dist/conversation.js"
    },
    "./inbox": {
      "types": "./dist/inbox.d.ts",
      "import": "./dist/inbox.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./logout": {
      "types": "./dist/logout.d.ts",
      "import": "./dist/logout.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./resume": {
      "types": "./dist/resume.d.ts",
      "import": "./dist/resume.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/conversation.ts src/inbox.ts src/host.ts src/logout.ts src/errors.ts src/resume.ts src/state.ts src/vue.ts --root src --outdir dist --format esm --target browser --splitting --external vue --chunk-naming 'chunks/[name]-[hash].[ext]' && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "CLAUDECODE=1 bun test"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.4.2",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vue": "^3.5.43"
  }
}
